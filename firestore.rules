rules_version = '2';

// ============================================================
// AzWord — Firestore Security Rules
// ============================================================
// Buni Firebase Console → Firestore Database → Rules bo'limiga
// joylashtiring va "Publish" tugmasini bosing.
//
// Muhim: bu fayl faqat GAT (kirish nazorati)ni ta'minlaydi.
// coins/stars miqdorini haqiqiy hisoblash (masalan: bitta
// mashg'ulot uchun ko'pi bilan nechta tanga berilishi mumkinligi)
// klientdan kelayotgani uchun rules bilan to'liq himoyalab
// bo'lmaydi — buning uzoq muddatli yechimi Cloud Function
// (pastdagi izohga qarang).
// ============================================================

function isSignedIn() {
  return request.auth != null;
}

function isOwner(uid) {
  return isSignedIn() && request.auth.uid == uid;
}

// Super-admin — kod ichida qattiq yozilgan, hech qachon settings
// hujjati orqali o'chirib bo'lmaydi (admin.html shuni ham talab qiladi).
function isSuperAdmin() {
  return isSignedIn() && request.auth.token.email == "abdurasul1406z@gmail.com";
}

// Qolgan adminlar ro'yxati /settings/main hujjatidagi `admins` massivida
// saqlanadi (admin.html dagi addAdmin/removeAdmin shu hujjatni yozadi).
function isAdmin() {
  return isSuperAdmin() || (
    isSignedIn() &&
    exists(/databases/$(database)/documents/settings/main) &&
    request.auth.token.email in get(/databases/$(database)/documents/settings/main).data.admins
  );
}

// Bitta so'rovda coins/stars qancha oshishi mumkinligini cheklash.
// Bitta mashg'ulotda (study.html) 20 tadan ortiq so'z bo'lmaydi deb,
// xavfsizlik marjasi bilan 100 qo'yilgan. O'zingiz eng katta papka
// hajmiga qarab moslashtiring.
function coinsDeltaOk() {
  let before = resource.data.coins is number ? resource.data.coins : 0;
  let after  = request.resource.data.coins is number ? request.resource.data.coins : 0;
  return after >= before && after - before <= 100;
}
function starsDeltaOk() {
  let before = resource.data.stars is number ? resource.data.stars : 0;
  let after  = request.resource.data.stars is number ? request.resource.data.stars : 0;
  return after >= before && after - before <= 100;
}

// Foydalanuvchi o'zi o'zgartira olmasligi kerak bo'lgan maydonlar:
// blocked, admin bergan maydonlar va h.k.
function onlyAllowedUserFieldsChanged() {
  let allowed = ['stars','coins','weeklyStars','weekKey','lastSeen',
                 'displayName','photoBase64','photoURL','equippedItems',
                 'settings','streakCount','lastStudyDate'];
  return request.resource.data.diff(resource.data).affectedKeys()
    .hasOnly(allowed);
}

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------- USERS ----------------
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid);
      allow update: if isAdmin() || (
        isOwner(uid) &&
        request.resource.data.blocked == resource.data.blocked &&
        onlyAllowedUserFieldsChanged() &&
        coinsDeltaOk() && starsDeltaOk()
      );
      allow delete: if isAdmin();
    }

    // ---------------- APP SETTINGS (admin ro'yxati, maintenance rejimi) ----------------
    match /settings/{docId} {
      allow read: if isSignedIn();
      // Faqat super-admin yangi admin qo'sha/o'chira oladi — oddiy admin
      // o'zini yoki boshqasini super-adminlik huquqisiz o'chirib qo'ymasin.
      allow write: if isSuperAdmin() || isAdmin();
    }

    // ---------------- FOLDERS (so'z bo'limlari) ----------------
    match /folders/{folderId} {
      allow read: if isSignedIn();
      // Faqat admin umumiy (isAdmin:true) bo'limlar yarata oladi;
      // oddiy foydalanuvchi faqat o'ziga tegishli (uid==o'zi) bo'lim yaratsin.
      allow create: if isAdmin() ||
        (isSignedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.isAdmin != true);
      allow update: if isAdmin() ||
        (isSignedIn() && resource.data.uid == request.auth.uid && resource.data.isAdmin != true);
      allow delete: if isAdmin() ||
        (isSignedIn() && resource.data.uid == request.auth.uid && resource.data.isAdmin != true);

      match /words/{wordId} {
        allow read: if isSignedIn();
        allow write: if isAdmin() ||
          (isSignedIn() && get(/databases/$(database)/documents/folders/$(folderId)).data.uid == request.auth.uid);
      }
    }

    // ---------------- STUDY RESULTS ----------------
    match /studyResults/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ---------------- ANNOUNCEMENTS ----------------
    match /announcements/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---------------- SHOP ----------------
    match /shop/{itemId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---------------- ACHIEVEMENTS (ta'rif ro'yxati) ----------------
    match /achievements/{achId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---------------- BOOKS (kitoblar: mavzular va so'zlar) ----------------
    match /books/{bookId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();

      match /topics/{topicId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();

        match /words/{wordId} {
          allow read: if isSignedIn();
          allow write: if isAdmin();
        }
      }
    }

    // Standart: hech narsaga ruxsat yo'q
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
