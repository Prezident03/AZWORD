rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users - hammaga read, ozi yoki admin write
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId || request.auth.token.email == "abdurasul1406z@gmail.com";

      match /purchases/{purchaseId} {
        allow read, write: if request.auth.uid == userId;
      }

      match /studyLog/{logId} {
        allow read, write: if request.auth.uid == userId;
      }
    }

    // Folders - faqat ega yoki admin write qila oladi
    match /folders/{folderId} {
      allow read: if request.auth != null;

      // Yangi papka: faqat o'z uid'i bilan yoki admin (isAdmin papka) yarata oladi
      allow create: if request.auth != null &&
        (request.resource.data.uid == request.auth.uid ||
         request.auth.token.email == "abdurasul1406z@gmail.com");

      // O'zgartirish/o'chirish: faqat papka egasi yoki admin
      allow update, delete: if request.auth != null &&
        (resource.data.uid == request.auth.uid ||
         request.auth.token.email == "abdurasul1406z@gmail.com");

      match /words/{wordId} {
        allow read: if request.auth != null;

        // So'z yozish: faqat shu papkaning egasi yoki admin
        allow write: if request.auth != null &&
          (get(/databases/$(database)/documents/folders/$(folderId)).data.uid == request.auth.uid ||
           request.auth.token.email == "abdurasul1406z@gmail.com");
      }
    }

    // Shop - hammaga read, faqat admin write
    match /shop/{itemId} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.email == "abdurasul1406z@gmail.com";
    }

    // Achievements - hammaga read, faqat admin write
    match /achievements/{achId} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.email == "abdurasul1406z@gmail.com";
    }

    // Announcements - hammaga read, faqat admin write
    match /announcements/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.email == "abdurasul1406z@gmail.com";
    }

    // Settings - hammaga read, faqat admin write
    match /settings/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.email == "abdurasul1406z@gmail.com";
    }

    // Books - hammaga read, faqat admin write
    match /books/{bookId} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.email == "abdurasul1406z@gmail.com";

      match /topics/{topicId} {
        allow read: if request.auth != null;
        allow write: if request.auth.token.email == "abdurasul1406z@gmail.com";

        match /words/{wordId} {
          allow read: if request.auth != null;
          allow write: if request.auth.token.email == "abdurasul1406z@gmail.com";
        }
      }
    }

    // Study Results - login qilgan har kim o'ziniki uchun yoza oladi
    match /studyResults/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth.token.email == "abdurasul1406z@gmail.com";
    }

  }
}
