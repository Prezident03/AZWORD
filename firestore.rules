rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users - hammaga read, ozi yoki admin write
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId || request.auth.token.email == "abdurasul1406z@gmail.com";

      match /purchases/{purchaseId} {
        allow read, write: if request.auth.uid == userId;
      }

      match /studyLog/{logId} {
        allow read, write: if request.auth.uid == userId;
      }
    }

    // Folders - faqat ega yoki admin write qila oladi
    match /folders/{folderId} {
      // O'qish: umumiy (isAdmin:true) bo'limlar hammaga, shaxsiy bo'limlar faqat egasiga/adminga
      allow read: if request.auth != null &&
        (resource.data.isAdmin == true ||
         resource.data.uid == request.auth.uid ||
         request.auth.token.email == "abdurasul1406z@gmail.com");

      // Yangi papka: faqat o'z uid'i bilan yoki admin (isAdmin papka) yarata oladi
      allow create: if request.auth != null &&
        (request.resource.data.uid == request.auth.uid ||
         request.auth.token.email == "abdurasul1406z@gmail.com");

      // O'zgartirish/o'chirish: faqat papka egasi yoki admin
      allow update, delete: if request.auth != null &&
        (resource.data.uid == request.auth.uid ||
         request.auth.token.email == "abdurasul1406z@gmail.com");

      match /words/{wordId} {
        // O'qish: faqat shu papka umumiy bo'lsa yoki o'quvchi uning egasi/admin bo'lsa
        allow read: if request.auth != null &&
          (get(/databases/$(database)/documents/folders/$(folderId)).data.isAdmin == true ||
           get(/databases/$(database)/documents/folders/$(folderId)).data.uid == request.auth.uid ||
           request.auth.token.email == "abdurasul1406z@gmail.com");

        // So'z yozish: faqat shu papkaning egasi yoki admin
        allow write: if request.auth != null &&
          (get(/databases/$(database)/documents/folders/$(folderId)).data.uid == request.auth.uid ||
           request.auth.token.email == "abdurasul1406z@gmail.com");
      }

      // Umumiy bo'limlar uchun mavzu qatlami (kitoblardagi kabi)
      match /topics/{topicId} {
        allow read: if request.auth != null &&
          (get(/databases/$(database)/documents/folders/$(folderId)).data.isAdmin == true ||
           get(/databases/$(database)/documents/folders/$(folderId)).data.uid == request.auth.uid ||
           request.auth.token.email == "abdurasul1406z@gmail.com");

        allow write: if request.auth != null &&
          (get(/databases/$(database)/documents/folders/$(folderId)).data.uid == request.auth.uid ||
           request.auth.token.email == "abdurasul1406z@gmail.com");

        match /words/{wordId} {
          allow read: if request.auth != null &&
            (get(/databases/$(database)/documents/folders/$(folderId)).data.isAdmin == true ||
             get(/databases/$(database)/documents/folders/$(folderId)).data.uid == request.auth.uid ||
             request.auth.token.email == "abdurasul1406z@gmail.com");

          allow write: if request.auth != null &&
            (get(/databases/$(database)/documents/folders/$(folderId)).data.uid == request.auth.uid ||
             request.auth.token.email == "abdurasul1406z@gmail.com");
        }
      }
    }

    // Shop - hammaga read, faqat admin write
    match /shop/{itemId} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.email == "abdurasul1406z@gmail.com";
    }

    // Achievements - hammaga read, faqat admin write
    match /achievements/{achId} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.email == "abdurasul1406z@gmail.com";
    }

    // Announcements - hammaga read, faqat admin write
    match /announcements/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.email == "abdurasul1406z@gmail.com";
    }

    // Settings - hammaga read, faqat admin write
    match /settings/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.email == "abdurasul1406z@gmail.com";
    }

    // Books - hammaga read, faqat admin write
    match /books/{bookId} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.email == "abdurasul1406z@gmail.com";

      match /topics/{topicId} {
        allow read: if request.auth != null;
        allow write: if request.auth.token.email == "abdurasul1406z@gmail.com";

        match /words/{wordId} {
          allow read: if request.auth != null;
          allow write: if request.auth.token.email == "abdurasul1406z@gmail.com";
        }
      }
    }

    // Study Results - faqat ozi yoki admin oqiy oladi, ozi yoza oladi
    match /studyResults/{docId} {
      allow read: if request.auth != null &&
        (resource.data.uid == request.auth.uid ||
         request.auth.token.email == "abdurasul1406z@gmail.com");
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth.token.email == "abdurasul1406z@gmail.com";
    }

  }
}
