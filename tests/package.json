{
  "name": "azword-tests",
  "private": true,
  "type": "module",
  "description": "AzWord uchun Firestore qoidalari va brauzer (E2E) testlari",
  "scripts": {
    "emulators": "firebase emulators:start --only firestore,auth --project demo-azword --config ../firebase.json",
    "test:rules": "firebase emulators:exec --only firestore --project demo-azword --config ../firebase.json \"node --test rules.test.mjs\"",
    "test:e2e": "firebase emulators:exec --only firestore,auth --project azword-30a2e --config ../firebase.json \"node e2e.mjs\"",
    "test:api": "firebase emulators:exec --only firestore,auth --project demo-azword --config ../firebase.json \"node --test api.test.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase": "10.12.0",
    "firebase-tools": "^13.0.0",
    "playwright": "^1.56.0"
  }
}
